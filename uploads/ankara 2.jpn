import os
import shutil

# Create the uploads folder if it doesn't exist
UPLOAD_DIR = "uploads"
os.makedirs(UPLOAD_DIR, exist_ok=True)

# Path to your image
source = r"C:\Users\YourName\Pictures\ankara2.jpg"   # Change this to your image's location

# Where you want to save it
destination = os.path.join(UPLOAD_DIR, "ankara2.jpg")

# Copy the image
shutil.copy(source, destination)

print("Image saved successfully!")